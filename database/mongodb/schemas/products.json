{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "products: the catalogue. Colour variants are embedded inside each product.",
    "required": ["name", "slug", "category", "basePrice", "status", "variants", "ratings", "createdAt"],
    "properties": {
      "name":        { "bsonType": "string", "minLength": 2, "maxLength": 200 },
      "slug":        { "bsonType": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "description": { "bsonType": "string" },
      "story":       { "bsonType": "string", "description": "The inspiration behind the piece" },
      "caption":     { "bsonType": "string" },
      "designer":    { "bsonType": "string" },
      "category":    { "enum": ["abaya", "perfume", "handbag", "bracelet", "shayla", "shoes", "accessory"] },
      "collection":  { "bsonType": ["string", "null"], "description": "collections.slug" },
      "season":      { "enum": ["SUMMER", "WINTER", "AUTUMN", "SPRING", null] },
      "seasonalLine":{ "bsonType": ["string", "null"], "description": "e.g. Velvet Moon" },
      "basePrice":   { "bsonType": "decimal", "description": "USD; a variant can override it" },
      "discountPercent": { "bsonType": "int", "minimum": 0, "maximum": 90 },
      "status":      { "enum": ["IN_PRODUCTION", "READY_TO_LAUNCH", "LIVE", "SOLD_OUT", "DISCONTINUED"] },
      "isNew":            { "bsonType": "bool" },
      "isBestSeller":     { "bsonType": "bool" },
      "isLimitedEdition": { "bsonType": "bool" },
      "launchDate":  { "bsonType": ["date", "null"] },
      "releaseDate": { "bsonType": ["date", "null"] },
      "tags":        { "bsonType": "array", "items": { "bsonType": "string" } },
      "images":      { "bsonType": "array", "items": { "bsonType": "string" } },
      "abaya": {
        "bsonType": "object",
        "description": "Only on abayas",
        "properties": {
          "fabric":         { "bsonType": "string" },
          "styles":         { "bsonType": "array", "items": { "enum": ["OPEN_FRONT", "CLOSED_FRONT", "HALF_CLOSED", "COMPLETELY_CLOSED"] } },
          "sizes":          { "bsonType": "array", "items": { "bsonType": "string" } },
          "lengths":        { "bsonType": "array", "items": { "bsonType": "string" } },
          "shaylaIncluded": { "bsonType": "bool" }
        }
      },
      "perfume": {
        "bsonType": "object",
        "description": "Only on perfumes",
        "properties": {
          "volumeMl": { "bsonType": "int", "minimum": 1 },
          "notes": {
            "bsonType": "object",
            "properties": {
              "top":   { "bsonType": "array", "items": { "bsonType": "string" } },
              "heart": { "bsonType": "array", "items": { "bsonType": "string" } },
              "base":  { "bsonType": "array", "items": { "bsonType": "string" } }
            }
          }
        }
      },
      "setItems": {
        "bsonType": "array",
        "description": "Rare Collectibles are sold as sets: what comes in the box",
        "items": {
          "bsonType": "object",
          "required": ["category", "description"],
          "properties": {
            "category":    { "bsonType": "string" },
            "description": { "bsonType": "string" }
          }
        }
      },
      "variants": {
        "bsonType": "array",
        "minItems": 1,
        "items": {
          "bsonType": "object",
          "required": ["sku", "colorName", "stock", "isDefault"],
          "properties": {
            "sku":           { "bsonType": "string", "pattern": "^VN-[A-Z0-9-]+$" },
            "colorName":     { "bsonType": "string" },
            "colorHex":      { "bsonType": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "stock":         { "bsonType": "int", "minimum": 0 },
            "priceOverride": { "bsonType": ["decimal", "null"] },
            "images":        { "bsonType": "array", "items": { "bsonType": "string" } },
            "isDefault":     { "bsonType": "bool" }
          }
        }
      },
      "ratings": {
        "bsonType": "object",
        "required": ["average", "count"],
        "description": "Summary kept in sync with the reviews collection",
        "properties": {
          "average": { "bsonType": ["double", "int"], "minimum": 0, "maximum": 5 },
          "count":   { "bsonType": "int", "minimum": 0 }
        }
      },
      "createdAt": { "bsonType": "date" },
      "updatedAt": { "bsonType": "date" }
    }
  }
}
