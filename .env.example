# Copy this file to .env and fill in real values. .env is git-ignored.

# MySQL: the receipt book (users, orders, payments)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=vela_noire
MYSQL_USER=vela_app
MYSQL_PASSWORD=change-me

# MongoDB: the menu album (products, reviews, clickstream)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vela_noire

# Signs login tokens (JWT). Base64, at least 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-base64-string
JWT_EXPIRATION_MINUTES=1440

# Where the shop and admin websites find the Java API
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SHOP_URL=http://localhost:3000
