# Copy this file to .env and fill in real values. .env is git-ignored.

# MySQL: the receipt book (users, orders, payments)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=vela_noire
MYSQL_USER=vela_app
MYSQL_PASSWORD=change-me

# MongoDB: the menu album (products, reviews, clickstream)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vela_noire
